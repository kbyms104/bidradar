# BidRadar 환경변수
# cp .env.example .env  후 값을 채우세요. (.env는 커밋/공유 금지)

# 데이터 소스: demo = seed.py 가상 데이터, live = collector.py 나라장터 실데이터
BIDRADAR_SOURCE=demo

# 공공데이터포털 '조달청_나라장터 입찰공고정보서비스' 일반 인증키(Encoding)
# https://www.data.go.kr/data/15129394/openapi.do → 활용신청 → 인증키 복사
DATA_GO_KR_KEY=

# 상담 신청 알림 (디스코드 웹훅 권장)
# 디스코드 채널 → 채널 편집 → 연동 → 웹훅 → 새 웹훅 → URL 복사
DISCORD_WEBHOOK_URL=

# (선택) 텔레그램을 쓰는 경우
# 봇 생성: 텔레그램에서 @BotFather → /newbot
# chat id 확인: 봇에게 말을 건 뒤 https://api.telegram.org/bot<토큰>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 서버 바인딩 (기본값)
# BIDRADAR_HOST=127.0.0.1
# BIDRADAR_PORT=8790

# 고객 계정·알림 조건 DB (기본: data/app.db)
# BIDRADAR_APP_DB=/home/ubuntu/bidradar/data/app.db

# 로그인 유지 기간(일, 기본 30)
# BIDRADAR_SESSION_DAYS=30

# 가입 방식: invite = 초대 코드 필요(기본), open = 누구나 가입
# BIDRADAR_SIGNUP=invite

# 관리자 페이지(/admin) Basic 인증 비밀번호 (비우면 /admin 404)
# python3 -c "import secrets; print(secrets.token_urlsafe(15))" 로 생성
BIDRADAR_ADMIN_PASSWORD=

# 약관·개인정보처리방침에 공개할 문의 이메일 (비우면 상담 폼 안내)
BIDRADAR_CONTACT_EMAIL=

# 발송 파이프라인이 실제로 돌고 있을 때만 1 (대시보드 LIVE 표시용)
# BIDRADAR_BID_ALERTS=1

# 공공데이터 API 일일 한도 관리 (개발계정 1,000회/일)
# BIDRADAR_API_DAILY_LIMIT=1000
# BIDRADAR_API_RESERVE=100

# 트래픽 급증 경고 기준 (1시간 구간)
# BIDRADAR_TRAFFIC_ALERT_REQ=300
# BIDRADAR_TRAFFIC_ALERT_IP=150
# BIDRADAR_TRAFFIC_ALERT_MB=500
# 자체 점검 트래픽을 뺄 서버 공인 IP (비우면 자동 감지)
# BIDRADAR_SELF_IPS=
